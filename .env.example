# Copy this file to .env and fill the values locally. Never commit .env with real secrets.
# Every variable below is read by the code; nothing here is required for local analysis.
# Keys can also be saved from Settings > IA, which keeps them in the local data directory.

# Local data (SQLite, JSON stores, backups). Default: data
SOTUHIRE_DATA_DIR=data

# Local API. It only binds to loopback (127.0.0.1, localhost, ::1); other hosts are refused.
SOTUHIRE_API_HOST=127.0.0.1
SOTUHIRE_API_PORT=8787
# Comma-separated. Defaults to the local web app origins. A non-loopback origin is refused
# unless SOTUHIRE_API_ALLOW_REMOTE_ORIGINS=1 is set on purpose; review the exposure first.
SOTUHIRE_API_ALLOWED_ORIGINS=
SOTUHIRE_API_ALLOWED_HOSTS=

# AI provider routing: local (default, no network), gemini, openai or anthropic.
# External providers only receive data after explicit opt-in in the app.
DEFAULT_AI_PROVIDER=local

# Google Gemini (extra: pip install -e ".[ai]")
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Anthropic Claude (extra: pip install -e ".[ai]"). Default model: Claude Haiku 5.5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: raises the GitHub API rate limit for public portfolio analysis. Read-only scope.
GITHUB_TOKEN=

# Backward-compatible aliases. Prefer DEFAULT_AI_PROVIDER, GEMINI_MODEL and GEMINI_API_KEY.
# LLM_PROVIDER=local
# LLM_MODEL=gemini-2.5-flash
# GOOGLE_API_KEY=
